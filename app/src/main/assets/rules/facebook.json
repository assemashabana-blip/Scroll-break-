{
  "schemaVersion": 1,
  "app": "facebook",
  "packages": ["com.facebook.katana"],

  "playerSignature": {
    "anyOf": [
      { "desc": "Reels, tab", "match": "startsWith", "selected": true },
      { "desc": "ريلز، علامة التبويب", "match": "startsWith", "selected": true }
    ]
  },

  "feedEntrySignatures": [
    {
      "name": "reels_tab_selected",
