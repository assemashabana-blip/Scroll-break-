        "anyOf": [
          { "desc": "Reels, tab", "match": "startsWith", "selected": true },
          { "desc": "ريلز، علامة التبويب", "match": "startsWith", "selected": true }
        ]
      }
    }
  ],

  "scrollSignal": { "className": "androidx.recyclerview.widget.RecyclerView" },

  "redirectTo": [
    { "desc": "Home, tab", "match": "startsWith", "clickable": true },
    { "desc": "الصفحة الرئيسية، علامة التبويب", "match": "startsWith", "clickable": true }
