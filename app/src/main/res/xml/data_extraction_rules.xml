<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The emergency password (a salted hash) never leaves the phone in a backup or transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="emergency.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="emergency.xml" />
    </device-transfer>
</data-extraction-rules>
