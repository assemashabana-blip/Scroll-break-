# R8 keep rules for the release build. AGP passes every file in src/main/keepRules to R8.
# The release build crashed at launch without these: libraries create the classes below by
# reflection (by name, with a no-argument or fixed constructor), which R8 cannot see.

# WorkManager's Room database (WorkDatabase_Impl) is created with a no-argument constructor.
-keep class * extends androidx.room.RoomDatabase { <init>(); }

# WorkManager creates workers (WatchdogWorker) by class name with this constructor.
-keep class * extends androidx.work.ListenableWorker {
    public <init>(android.content.Context, androidx.work.WorkerParameters);
}

# androidx.startup initializers listed in the manifest are created with a no-argument constructor.
-keep class * implements androidx.startup.Initializer { <init>(); }
